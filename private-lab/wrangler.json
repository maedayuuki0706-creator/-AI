{
  "name": "boat-private-lab",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": "",
    "DATA_BACKEND": "r2",
    "R2_PACKED": "1",
    "DATA_PREFIX": "releases/official-2022-2025-v1/query"
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "boat-private-lab-archive"
    }
  ]
}
