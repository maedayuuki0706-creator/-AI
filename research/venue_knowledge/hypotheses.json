  "goal": "Separate sourced knowledge from measured evidence and validated predictive effects",
  "default_status": "article_inspired_unvalidated",
  "validation_policy": {
    "min_races_per_condition": 200,
    "comparison": "temporal_holdout_by_event_day",
    "sample_notes": "200 is a gate to consider testing, not proof of lift",
    "zero_weight_until_passed": true
  },
  "hypotheses": [
    {
      "id": "edogawa-tide-wind-interaction",
      "jcd": "03",
      "title": "潮流位相×風向×波高の交互作用",
      "source_ids": [
        "edogawa-national-overview",
        "edogawa-official-2023-feature"
      ],
      "proposition": "同じ風速でも上げ潮と下げ潮、風向・波高の組合せでコース別頭率・相手連動が変化するか",
      "target_measures": [
        "course_win_rate",
        "second_third_conditional",
        "miss_generation_rate"
      ],
      "required_fields": [
        "official_deadline_at",
        "official_actual_entrance",
        "start_at",
        "measured_tide_phase",
        "wind_direction_compass",
        "wind_mps",
        "wave_cm",
        "official_trifecta"
      ],
      "conditioning": [
        "month",
        "race_grade",
        "racer_strength",
        "course",
        "day"
      ],
      "testing_plan": "まず水面別観測点と計時をそろえ、開催日単位で時系列外分割。強風の小標本を一括で使わず、弱風との比較と風向別の信頼区間を算出。",
      "exclusion_notes": "潮位推定を実測潮流の方向と扱わない。風向アイコンを未確認のまま方位に変換しない。",
      "priority": "high",
      "review_status": "article_inspired_unvalidated",
      "predictive_weight": 0,
      "auto_promote": false,
      "source_history_before_observation_verified": false
    },
    {
